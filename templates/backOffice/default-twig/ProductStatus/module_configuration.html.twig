{# Configuration fragment — no {% extends %} — rendered inside the module-configure page #}
{% set return_url = path('admin.module.configure', {module_code: 'ProductStatus', edit_language_id: edit_language_id}) %}

<div class="d-flex justify-content-end mb-3">
    {{ component('BoLanguageSwitcher', {currentLanguageId: edit_language_id}) }}
</div>

<div class="card mb-4">
    <div class="card-header">
        {{ 'Existing status'|trans({}, 'productstatus') }}
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>{{ 'Id'|trans }}</th>
                        <th>{{ 'Code'|trans }}</th>
                        <th>{{ 'Title'|trans }}</th>
                        <th>{{ 'Description'|trans }}</th>
                        <th class="text-end">{{ 'Actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for status in statuses %}
                        <tr>
                            <td>{{ status.id }}</td>
                            <td>{{ status.code }}</td>
                            <td>
                                <span class="badge" style="background-color: {{ status.color }};">{{ status.title }}</span>
                            </td>
                            <td>{{ status.description }}</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    {% if is_granted('UPDATE', {resource: 'admin.module', module: 'ProductStatus'}) %}
                                        <a class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#product-status-edit-{{ status.id }}"
                                           title="{{ 'Edit status'|trans({}, 'productstatus') }}">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    {% endif %}
                                    {% if not status.protected and is_granted('UPDATE', {resource: 'admin.module', module: 'ProductStatus'}) %}
                                        <a class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#product-status-delete-{{ status.id }}"
                                           title="{{ 'Delete this status'|trans({}, 'productstatus') }}">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        {{ 'Add a status'|trans({}, 'productstatus') }}
    </div>
    <div class="card-body">
        {% form_theme create_form with bo_form_themes only %}
        {{ form_start(create_form, {action: path('product_status.status.create'), method: 'post'}) }}
        {{ form_widget(create_form.success_url, {value: return_url}) }}
        {{ form_widget(create_form.error_url, {value: return_url}) }}
        {% do create_form.success_url.setRendered %}
        {% do create_form.error_url.setRendered %}
        <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">

        <div class="row">
            <div class="col-md-3">{{ form_row(create_form.code) }}</div>
            <div class="col-md-3">{{ form_row(create_form.title) }}</div>
            <div class="col-md-4">{{ form_row(create_form.description) }}</div>
            <div class="col-md-2">{{ form_row(create_form.color) }}</div>
        </div>

        <button type="submit" class="btn btn-primary">
            {{ 'Add a status'|trans({}, 'productstatus') }}
        </button>

        {{ form_end(create_form) }}
    </div>
</div>

{% for status in statuses %}
    <div class="modal fade" id="product-status-edit-{{ status.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'Edit status'|trans({}, 'productstatus') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    {% set edit_form = edit_forms[status.id] %}
                    {% form_theme edit_form with bo_form_themes only %}
                    {{ form_start(edit_form, {action: path('product_status.status.update', {id: status.id}), method: 'post'}) }}
                    {{ form_widget(edit_form.success_url, {value: return_url}) }}
                    {{ form_widget(edit_form.error_url, {value: return_url}) }}
                    {% do edit_form.success_url.setRendered %}
                    {% do edit_form.error_url.setRendered %}
                    <input type="hidden" name="edit_language_id" value="{{ edit_language_id }}">

                    {{ form_row(edit_form.code, {attr: {readonly: status.protected}}) }}
                    {{ form_row(edit_form.title) }}
                    {{ form_row(edit_form.description) }}
                    {{ form_row(edit_form.color) }}

                    <div class="modal-footer px-0 pb-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <button type="submit" class="btn btn-primary">{{ 'Edit status'|trans({}, 'productstatus') }}</button>
                    </div>
                    {{ form_end(edit_form) }}
                </div>
            </div>
        </div>
    </div>

    {% if not status.protected %}
        <div class="modal fade" id="product-status-delete-{{ status.id }}" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ 'Delete this status'|trans({}, 'productstatus') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {{ 'Do you really want to delete this status ?'|trans({}, 'productstatus') }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <form method="post" action="{{ path('product_status.status.delete', {id: status.id}) }}">
                            <input type="hidden" name="_token" value="{{ delete_token }}">
                            <button type="submit" class="btn btn-danger">{{ 'Delete this status'|trans({}, 'productstatus') }}</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endfor %}
